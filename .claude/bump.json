{
  "version_source": "pyproject.toml",
  "version_pattern": "^version\\s*=\\s*\"([0-9]+\\.[0-9]+\\.[0-9]+)\"",
  "files": [
    {
      "path": "pyproject.toml",
      "pattern": "version = \"{OLD}\"",
      "replace": "version = \"{NEW}\""
    },
    {
      "path": "frontend/package.json",
      "pattern": "\"version\": \"{OLD}\"",
      "replace": "\"version\": \"{NEW}\""
    },
    {
      "path": "src/mame_curator/__init__.py",
      "pattern": "__version__ = \"{OLD}\"",
      "replace": "__version__ = \"{NEW}\""
    },
    {
      "path": "uv.lock",
      "pattern": "name = \"mame-curator\"\nversion = \"{OLD}\"",
      "replace": "name = \"mame-curator\"\nversion = \"{NEW}\""
    },
    {
      "path": "frontend/package-lock.json",
      "pattern": "\"name\": \"mame-curator-frontend\",\n  \"version\": \"{OLD}\"",
      "replace": "\"name\": \"mame-curator-frontend\",\n  \"version\": \"{NEW}\""
    },
    {
      "path": "frontend/package-lock.json",
      "pattern": "\"name\": \"mame-curator-frontend\",\n      \"version\": \"{OLD}\"",
      "replace": "\"name\": \"mame-curator-frontend\",\n      \"version\": \"{NEW}\""
    }
  ],
  "post_check": "uv run pytest tests/docs/test_version_lockstep.py -q",
  "todos": [
    "Move [Unreleased] into a dated `## [{NEW}] - {TODAY}` section with changelog_log op:\"release\", then add its **Theme:** line (authoring)."
  ]
}
